[Unit]
Description=Ace of Angels private VPN dogfight host
Wants=network-online.target
# Ordering also covers Tailscale when installed and enabled for internet play.
After=network-online.target tailscaled.service
StartLimitIntervalSec=600
StartLimitBurst=4

[Service]
Type=simple
User=aoa
Group=aoa
WorkingDirectory=/opt/ace-of-angels
# Only for hosts still on the older rotation.json + host.env pair (aoa_host.py reads it too).
EnvironmentFile=-/etc/ace-of-angels/host.env
StateDirectory=ace-of-angels
StateDirectoryMode=0750
UMask=0027
# tools/aoa_host.py is the shim for aoa/host/headless.py: install aoa/ and tools/.
# It restarts a crashed game process itself (3 per 10 minutes); systemd restarts the controller.
ExecStart=/usr/bin/python3 -I -u /opt/ace-of-angels/tools/aoa_host.py run /etc/ace-of-angels/host.json
Restart=on-failure
RestartSec=30
# The controller stops its child; both unwind socket/log context managers.
KillSignal=SIGINT
KillMode=mixed
TimeoutStopSec=15
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict

[Install]
WantedBy=multi-user.target
